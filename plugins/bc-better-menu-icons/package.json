{
  "name": "bc-better-menu-icons",
  "version": "2.0.0",
  "description": "Replace WordPress dashicons font with @wordpress/icons",
  "private": true,
  "scripts": {
    "extract-svgs": "node src/extract-svgs.js",
    "generate-css": "node src/generate-css.js",
    "generate-font": "fontforge -script src/generate-font-fontforge.py",
    "build": "npm run extract-svgs && npm run generate-font && npm run generate-css"
  },
  "dependencies": {
    "@wordpress/icons": "^10.0.0"
  },
  "devDependencies": {
    "@wordpress/element": "^6.0.0"
  }
}
