{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Omnibar Editor Menu Trigger",
		"author": "Brian Coords",
		"description": "Try the Omnibar drawer from the Site Editor and block editor header."
	},
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"landingPage": "/wp-admin/",
	"login": true,
	"steps": [
		{
			"step": "installTheme",
			"themeData": {
				"resource": "wordpress.org/themes",
				"slug": "twentytwentyfive"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/bacoords/omnibar-experiments",
				"ref": "v0.1.6",
				"refType": "tag",
				"path": "plugins/omnibar-admin-drawer"
			},
			"options": {
				"activate": true,
				"targetFolderName": "omnibar-admin-drawer"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/bacoords/omnibar-experiments",
				"ref": "v0.1.6",
				"refType": "tag",
				"path": "plugins/bc-better-menu-icons"
			},
			"options": {
				"activate": true,
				"targetFolderName": "bc-better-menu-icons"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/bacoords/omnibar-experiments",
				"ref": "v0.1.6",
				"refType": "tag",
				"path": "plugins/omnibar-editor-menu-trigger"
			},
			"options": {
				"activate": true,
				"targetFolderName": "omnibar-editor-menu-trigger"
			}
		}
	]
}
