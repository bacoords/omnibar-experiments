{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Omnibar Focus Menu",
		"author": "Brian Coords",
		"description": "Try a contextual focus mode for the WordPress admin menu."
	},
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"landingPage": "/wp-admin/",
	"login": true,
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/bacoords/omnibar-experiments",
				"ref": "v0.1.6",
				"refType": "tag",
				"path": "plugins/omnibar-admin-drawer"
			},
			"options": {
				"activate": true,
				"targetFolderName": "omnibar-admin-drawer"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/bacoords/omnibar-experiments",
				"ref": "v0.1.6",
				"refType": "tag",
				"path": "plugins/bc-better-menu-icons"
			},
			"options": {
				"activate": true,
				"targetFolderName": "bc-better-menu-icons"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/bacoords/omnibar-experiments",
				"ref": "v0.1.6",
				"refType": "tag",
				"path": "plugins/omnibar-focus-menu"
			},
			"options": {
				"activate": true,
				"targetFolderName": "omnibar-focus-menu"
			}
		}
	]
}
